<%- include('partials/head') %>
<%- include('partials/header') %>

<% if (showArrivalBanner) { %>
<section class="arrival-banner">
  <div class="arrival-banner__wrap">

    <div class="arrival-banner__icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M199.2 181.4L173.1 256L466.9 256L440.8 181.4C436.3 168.6 424.2 160 410.6 160L229.4 160C215.8 160 203.7 168.6 199.2 181.4zM103.6 260.8L138.8 160.3C152.3 121.8 188.6 96 229.4 96L410.6 96C451.4 96 487.7 121.8 501.2 160.3L536.4 260.8C559.6 270.4 576 293.3 576 320L576 512C576 529.7 561.7 544 544 544L512 544C494.3 544 480 529.7 480 512L480 480L160 480L160 512C160 529.7 145.7 544 128 544L96 544C78.3 544 64 529.7 64 512L64 320C64 293.3 80.4 270.4 103.6 260.8zM192 368C192 350.3 177.7 336 160 336C142.3 336 128 350.3 128 368C128 385.7 142.3 400 160 400C177.7 400 192 385.7 192 368zM480 400C497.7 400 512 385.7 512 368C512 350.3 497.7 336 480 336C462.3 336 448 350.3 448 368C448 385.7 462.3 400 480 400z"/></svg>
    </div>

    <div class="arrival-banner__content">
      <h3>Heading to Moroni's Quest?</h3>
      <p>
        Find arrival times, drop-off instructions, Google Maps directions,
        and the traffic flow map.
      </p>
    </div>

    <a href="/arriving" class="arrival-banner__btn">
      View Arrival Information →
    </a>

  </div>
</section>
<% } %>

<main class="hero">
  <div class="overlay"></div>
  <header class="center">
    <img class="logoLarge" src="/img/MQ_logo_gold.png" alt="Moroni's Quest logo" />
    <p class="tagline"><%= slogan %></p>
    <p class="event-date">September 1&ndash;4, 2027</p>
    <section class="countdown" aria-live="polite">
      <div class="time"><span id="d">0</span><small>Days</small></div>
      <div class="time"><span id="h">0</span><small>Hours</small></div>
      <div class="time"><span id="m">0</span><small>Minutes</small></div>
      <div class="time"><span id="s">0</span><small>Seconds</small></div>
    </section>

    <!--<a class="cta" href="#about">Enter the Quest</a>-->
  </header>
</main>




<section class="home-overview" id="about">
  <div class="home-overview__mountains" aria-hidden="true"></div>
  <div class="wrap">
    <header class="home-overview__header">
      <p class="home-overview__eyebrow">Abbotsford <span>•</span> Surrey <span>•</span> Vancouver Stakes</p>
      <h2>Khalsa Centre at Miracle Valley</h2>
      <p>Home of Moroni’s Quest</p>
      <div class="home-overview__separator" aria-hidden="true"></div>
    </header>

    <div class="home-facts" aria-label="Event details">
      <article class="home-fact">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
        <div><h3>Location</h3><p>Khalsa Centre<br>14100 Stave Lake Road<br>Mission, BC V2V 0A5</p></div>
      </article>
      <article class="home-fact">
        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
        <div><h3>Dates</h3><p>September 1–4,<br>2027</p></div>
      </article>
      <article class="home-fact">
        <i class="fa-solid fa-people-group" aria-hidden="true"></i>
        <div><h3>Who</h3><p>Youth turning 12 in 2027 through those graduating Grade 12 in 2027.</p></div>
      </article>
      <article class="home-fact">
        <i class="fa-solid fa-coins" aria-hidden="true"></i>
        <div><h3>Cost</h3><p>No cost for youth of the stake.</p></div>
      </article>
    </div>

    <div class="home-details-grid">
      <article class="home-info-card home-directions">
        <header class="home-card-heading">
          <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
          <div><h3>Getting There</h3><p>Find your way to Miracle Valley</p></div>
        </header>
        <div class="home-directions__body">
          <div class="home-directions__copy">
            <address><strong>Khalsa Centre</strong><br>14100 Stave Lake Road<br>Mission, BC V2V 0A5</address>
            <a class="home-map-link" href="https://www.google.com/maps/search/?api=1&amp;query=14100+Stave+Lake+Road+Mission+BC" target="_blank" rel="noopener">
              <i class="fa-regular fa-map" aria-hidden="true"></i> Open in Google Maps <span aria-hidden="true">↗</span>
            </a>
            <p>When you arrive, look for the designated Moroni’s Quest drop-off area. Signs will guide you.</p>
          </div>
          <iframe class="home-map" title="Map showing Khalsa Centre at Miracle Valley" loading="lazy" src="https://maps.google.com/maps?width=600&amp;height=400&amp;hl=en&amp;q=14100 Stave Lake Road, Mission, BC V2V 0A5&amp;t=&amp;z=14&amp;ie=UTF8&amp;iwloc=B&amp;output=embed"></iframe>
        </div>
      </article>

      <article class="home-info-card home-arrivals">
        <header class="home-card-heading">
          <i class="fa-regular fa-clock" aria-hidden="true"></i>
          <div><h3>Arrival Times</h3><p>Wednesday, September 1</p></div>
        </header>
        <div class="home-leader-time">
          <i class="fa-solid fa-people-group" aria-hidden="true"></i>
          <div><strong>Leader Check-in</strong><b>7:30 AM</b></div>
          <span>Early check-in available</span>
        </div>
        <div class="home-youth-times">
          <h4>Youth Check-in</h4>
          <div class="home-youth-times__grid">
            <div><span>Abbotsford Stake</span><strong>9:00 AM</strong></div>
            <div><span>Surrey Stake</span><strong>9:20 AM</strong></div>
            <div><span>Vancouver Stake</span><strong>9:40 AM</strong></div>
          </div>
        </div>
      </article>
    </div>

    <div class="home-expect">
      <figure class="home-expect__photo">
        <img src="/img/youth3.jpg" alt="Youth together at Moroni's Quest">
      </figure>
      <article class="home-expect__copy">
        <header><h3>What to Expect</h3><p>Step into the Book of Mormon</p></header>
        <p>Moroni’s Quest lets youth experience the Book of Mormon in a real and powerful way. Through scripture-based reenactments, tribe activities, challenges, and devotionals, youth will learn, serve, and build lasting friendships.</p>
        <div class="home-expect__features">
          <div><i class="fa-solid fa-book-open" aria-hidden="true"></i><span>Scripture-based reenactments</span></div>
          <div><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Stories, battles, and lessons from the Book of Mormon</span></div>
          <div><i class="fa-solid fa-campground" aria-hidden="true"></i><span>Tribe activities and games</span></div>
          <div><i class="fa-solid fa-fire" aria-hidden="true"></i><span>Evening activities and camping</span></div>
          <div><i class="fa-solid fa-people-group" aria-hidden="true"></i><span>Discussions and devotionals</span></div>
          <div><i class="fa-solid fa-heart" aria-hidden="true"></i><span>Build faith in Jesus Christ and lasting memories</span></div>
        </div>
      </article>
    </div>

    <div class="home-bottom-cards">
      <article><i class="fa-solid fa-bed" aria-hidden="true"></i><div><h3>Accommodations</h3><p>Youth will sleep in dorm-style accommodation with their own bed. Youth may request one roommate of the same gender.</p></div></article>
      <article><i class="fa-solid fa-user" aria-hidden="true"></i><div><h3>Tribes</h3><p>Youth are placed in tribes to experience stories, battles, and lessons from the Book of Mormon.</p></div></article>
      <article><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><div><h3>Conduct</h3><p>All activities follow Church standards. Come ready to have fun, be kind, and help keep the Spirit of the camp.</p></div></article>
    </div>
  </div>
</section>

<!-- BOM content -->
 <%- include('partials/bom') %>

<%- include('partials/footer') %>
<%- include('partials/foot') %>
